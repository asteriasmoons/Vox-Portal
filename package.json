{
  "name": "vox-bugs-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Vox Bugs Bot — standalone Telegram bug-reporting bot + Mini App on Cloudflare Workers.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute vox_bugs --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute vox_bugs --remote --file=./schema.sql",
    "set-webhook": "node scripts/set-webhook.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.90.0"
  }
}
